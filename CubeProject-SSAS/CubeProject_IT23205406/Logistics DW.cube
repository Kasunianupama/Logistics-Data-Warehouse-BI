  <Source dwd:design-time-name="a3655f87-eaf3-46fd-bbca-bc7d0c12c31c">
    <DataSourceViewID>Logistics DW</DataSourceViewID>
  </Source>
  <Kpis>
    <Kpi dwd:design-time-name="b2d8171a-30c9-4d34-9a5b-9dfeccd16006">
      <ID>KPI</ID>
      <Name>Delivery Volume Target</Name>
      <AssociatedMeasureGroupID>Fact Delivery Events</AssociatedMeasureGroupID>
      <Value>[Measures].[Fact Delivery Events Count]</Value>
      <Goal>100</Goal>
      <Status>Case
  When KpiValue("Delivery Volume Target") &gt;= KpiGoal("Delivery Volume Target") Then 1
  When KpiValue("Delivery Volume Target") &gt;= (KpiGoal("Delivery Volume Target") * 0.85) Then 0
  Else -1
End</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="dfcc84e4-2b18-48d8-bbca-39fbd78f7ef3">
      <ID>KPI 1</ID>
      <Name>Fuel Cost Control</Name>
      <AssociatedMeasureGroupID>Fact Fuel Purchases</AssociatedMeasureGroupID>
      <Value>[Measures].[Cost]</Value>
      <Goal>1000</Goal>
      <Status>Case
  When KpiValue("Fuel Cost Control") &lt;= KpiGoal("Fuel Cost Control") Then 1
  When KpiValue("Fuel Cost Control") &lt;= (KpiGoal("Fuel Cost Control") * 1.15) Then 0
  Else -1
End</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>